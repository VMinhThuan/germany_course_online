NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb+srv://staging-user:replace-with-owner-issued-secret@staging-cluster.example.invalid/?retryWrites=true&w=majority
MONGODB_DB_NAME=paniverse_lms_stage
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=https://api.staging.example.invalid
JWT_AUDIENCE=paniverse-web
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_DAYS=30
APP_ORIGINS=https://staging.example.invalid
# Set through the approved secret manager only when a Vercel Cron schedule is enabled.
CRON_SECRET=replace-with-a-random-secret-of-at-least-32-characters
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
PASSWORD_RESET_URL=

# Optional SMTP. Configure the complete tuple only with an approved staging mailbox.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional private S3-compatible storage. Configure every MEDIA_S3_* value together.
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_SIGNED_URL_TTL_SECONDS=300
