ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_DAYS=30
APP_ORIGINS=https://staging.example.invalid
LESSON_COMMENTS_ENABLED=true
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
PASSWORD_RESET_URL=

# Optional SMTP. Configure the complete tuple only with an approved staging mailbox.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_NOTIFICATION_EMAIL=syqv1985@gmail.com

# Configure only after verifying the receiving BIDV account with the owner.
VIETQR_BANK_BIN=970418
VIETQR_ACCOUNT_NO=4210541181
VIETQR_ACCOUNT_NAME=NGUYEN PHUONG ANH
VIETQR_TEMPLATE=compact2

