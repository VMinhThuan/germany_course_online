{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/index.ts": {
      "maxDuration": 60,
      "includeFiles": "openapi.yaml"
    }
  },
  "crons": [
    {
      "path": "/api/internal/orders/expire",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/internal/email-outbox/process",
      "schedule": "* * * * *"
    }
  ]
}
