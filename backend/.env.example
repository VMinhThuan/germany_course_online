NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=paniverse_lms_dev
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=https://api.example.test
JWT_AUDIENCE=paniverse-web
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_DAYS=30
APP_ORIGINS=http://localhost:5173
# Optional; generate a private value of at least 32 characters before scheduling the outbox endpoint.
CRON_SECRET=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
PASSWORD_RESET_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional protected media signing (S3-compatible provider). Leave all blank until configured.
MEDIA_PROVIDER=
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_SIGNED_URL_TTL_SECONDS=300

# Optional single active Cloudinary account for course images, PDFs, and audio. Keep the API secret server-side.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PDF_FOLDER=lesson-pdf
CLOUDINARY_AUDIO_FOLDER=quiz-audio
CLOUDINARY_COURSE_BANNER_FOLDER=course-banner
CLOUDINARY_LESSON_AUDIO_FOLDER=lesson-audio
# Use "dynamic" only when the Cloudinary product environment uses Dynamic Folders.
CLOUDINARY_FOLDER_MODE=dynamic
