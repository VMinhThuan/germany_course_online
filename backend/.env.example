NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=paniverse_lms_dev
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=https://api.example.test
JWT_AUDIENCE=paniverse-web
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_DAYS=30
APP_ORIGINS=http://localhost:5173
LESSON_COMMENTS_ENABLED=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
PASSWORD_RESET_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_NOTIFICATION_EMAIL=syqv1985@gmail.com

# Optional dynamic VietQR Quick Link. Set the account name only after verifying it with BIDV.
VIETQR_BANK_BIN=970418
VIETQR_ACCOUNT_NO=4210541181
VIETQR_ACCOUNT_NAME=NGUYEN PHUONG ANH
VIETQR_TEMPLATE=compact2

# Optional protected media signing for generic course media (S3-compatible provider).
# Payment Proof does not use these settings; it always uses the existing Cloudinary account below.
MEDIA_PROVIDER=
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_SIGNED_URL_TTL_SECONDS=300

# Optional single active Cloudinary account for course images, PDFs, audio, and Payment Proof.
# Payment Proof uses the fixed private folder "payment-proofs"; no extra ENV is required.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PDF_FOLDER=lesson-pdf
CLOUDINARY_AUDIO_FOLDER=quiz-audio
CLOUDINARY_COURSE_BANNER_FOLDER=course-banner
CLOUDINARY_LESSON_AUDIO_FOLDER=lesson-audio
CLOUDINARY_WEB_CONTENT_FOLDER=web-content
# Use "dynamic" only when the Cloudinary product environment uses Dynamic Folders.
CLOUDINARY_FOLDER_MODE=dynamic
