{
  "name": "paniversedeutsch-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests scripts --max-warnings=0",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json eslint.config.mjs vitest.config.ts",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "e2e:server": "tsx scripts/be04-e2e-server.ts",
    "check:openapi": "tsx scripts/validate-openapi.ts",
    "db:indexes": "tsx scripts/create-indexes.ts",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "mongoose": "^9.11.4",
    "nodemailer": "^10.3.1",
    "pino": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.14.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
